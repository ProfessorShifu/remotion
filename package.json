{
  "name": "prostuti-motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Remotion campaign studio for Prostuti.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render:landscape": "remotion render src/index.ts Prostuti-Landscape out/prostuti-landscape.mp4",
    "render:vertical": "remotion render src/index.ts Prostuti-Vertical out/prostuti-vertical.mp4",
    "render:square": "remotion render src/index.ts Prostuti-Square out/prostuti-square.mp4",
    "render:all": "npm run render:landscape && npm run render:vertical && npm run render:square",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "remotion": "4.0.543",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3"
  }
}
