{
  "name": "bangla-motion-studio",
  "version": "1.0.0",
  "description": "Reusable, adaptable Remotion 3D/2D Bangla storytelling studio with global primitives and per-project folders.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:golpo01": "remotion render Golpo01SonarToroni out/golpo-01-sonar-toroni.mp4 --gl=swangle",
    "render:golpo02": "remotion render Golpo02LittleFirefly out/golpo-02-little-firefly.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.4",
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/three": "4.0.543",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.543",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/three": "^0.170.0",
    "typescript": "5.7.3"
  }
}
